# ---- Game server (apps/server) ----
PORT=2567
NODE_ENV=development
# Random string, 32+ chars. Signs guest identity tokens. REQUIRED in production.
GUEST_TOKEN_SECRET=
# Bearer token for /admin endpoints, 24+ chars. REQUIRED in production.
ADMIN_TOKEN=
# Comma-separated browser origins allowed to connect, e.g. https://ozu.vercel.app
ALLOWED_ORIGINS=
# Optional Postgres (Supabase) connection string. Without it, a JSON file in DATA_DIR is used.
DATABASE_URL=
DATA_DIR=./data
# Optional: enable member accounts. JWTs are verified against Supabase's JWKS,
# or SUPABASE_JWT_SECRET for legacy HS256 projects.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Allow guests to chat (default: true when accounts are disabled, false when enabled).
GUEST_CHAT=
MAX_PLAYERS_PER_DISTRICT=40

# ---- Web client (apps/web) — see apps/web/.env.example ----
